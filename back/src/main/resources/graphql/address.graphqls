extend type Query {
    myAddresses: [UserAddress!]!
    """The other person's address in a connection (shared by default). Null when they haven't entered one."""
    penPalAddress(connectionId: ID!): UserAddress
}

extend type Mutation {
    createAddress(input: CreateAddressInput!): UserAddress!
    updateAddress(id: ID!, input: UpdateAddressInput!): UserAddress!
    deleteAddress(id: ID!): Boolean!
}

"""Confidential. Exposed to another user only through penPalAddress, for people they are connected with."""
type UserAddress {
    id: ID!
    recipientName: String!
    streetLine1: String!
    streetLine2: String
    city: String!
    region: String
    postalCode: String
    countryCode: String!
    isPrimary: Boolean!
    verifiedAt: String
    createdAt: String!
    updatedAt: String!
}

input CreateAddressInput {
    recipientName: String!
    streetLine1: String!
    streetLine2: String
    city: String!
    region: String
    postalCode: String
    countryCode: String!
    isPrimary: Boolean
}

input UpdateAddressInput {
    recipientName: String
    streetLine1: String
    streetLine2: String
    city: String
    region: String
    postalCode: String
    countryCode: String
    isPrimary: Boolean
}
