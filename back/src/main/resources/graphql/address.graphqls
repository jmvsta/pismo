extend type Query {
    myAddresses: [UserAddress!]!
    addressConsentsForConnection(connectionId: ID!): [ConnectionAddressConsent!]!
}

extend type Mutation {
    createAddress(input: CreateAddressInput!): UserAddress!
    updateAddress(id: ID!, input: UpdateAddressInput!): UserAddress!
    deleteAddress(id: ID!): Boolean!
    grantAddressConsent(connectionId: ID!, addressId: ID!): ConnectionAddressConsent!
    revokeAddressConsent(connectionId: ID!): ConnectionAddressConsent!
}

"""Confidential. Never exposed for another user directly -- only through a GRANTED ConnectionAddressConsent."""
type UserAddress {
    id: ID!
    recipientName: String!
    streetLine1: String!
    streetLine2: String
    city: String!
    region: String
    postalCode: String
    countryCode: String!
    isPrimary: Boolean!
    verifiedAt: String
    createdAt: String!
    updatedAt: String!
}

"""One row per user per connection: has this user shared their address with the other side? No row, or REVOKED, means letters go through the team relay."""
type ConnectionAddressConsent {
    id: ID!
    connection: PenPalConnection!
    grantor: User!
    address: UserAddress
    status: AddressConsentStatus!
    grantedAt: String!
    revokedAt: String
}

enum AddressConsentStatus {
    GRANTED
    REVOKED
}

input CreateAddressInput {
    recipientName: String!
    streetLine1: String!
    streetLine2: String
    city: String!
    region: String
    postalCode: String
    countryCode: String!
    isPrimary: Boolean
}

input UpdateAddressInput {
    recipientName: String
    streetLine1: String
    streetLine2: String
    city: String
    region: String
    postalCode: String
    countryCode: String
    isPrimary: Boolean
}
