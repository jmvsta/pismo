extend type Query {
    badges: [Badge!]!
    myBadges: [UserBadge!]!
    letterRankBadges: [LetterRankBadge!]!
    myLetterRankBadges: [UserLetterRankBadge!]!
}

type Badge {
    id: ID!
    code: String!
    title: String!
    description: String
    iconUrl: String
    position: Int!
    active: Boolean!
}

type UserBadge {
    user: User!
    badge: Badge!
    awardedAt: String!
}

"""Awarded automatically once a user's count of actually-sent letters reaches minLetters; accumulates across tiers."""
type LetterRankBadge {
    id: ID!
    code: String!
    title: String!
    minLetters: Int!
    maxLetters: Int
    iconUrl: String
    position: Int!
}

type UserLetterRankBadge {
    user: User!
    badge: LetterRankBadge!
    awardedAt: String!
}
