extend type Query {
    aboutPage: AboutPage!
}

extend type Mutation {
    addAboutPageCanvas: AboutPage!
    moveAboutPageCanvas(id: ID!, direction: AboutPageMoveDirection!): AboutPage!
    updateAboutPageCanvasHeight(id: ID!, height: Float!): AboutPage!
    updateAboutPageCanvasRounded(id: ID!, rounded: Boolean!): AboutPage!
    updateAboutPageBlockRounded(id: ID!, rounded: Boolean!): AboutPage!
    updateAboutPageCanvasBordered(id: ID!, bordered: Boolean!): AboutPage!
    updateAboutPageBlockHighlighted(id: ID!, highlighted: Boolean!): AboutPage!
    updateAboutPageBlockIcon(id: ID!, icon: String): AboutPage!
    updateAboutPageCanvasBackground(id: ID!, mimeType: String!, imageBase64: String!): AboutPage!
    removeAboutPageCanvasBackground(id: ID!): AboutPage!
    removeAboutPageCanvas(id: ID!): AboutPage!
    addAboutPageTextBlock(
        canvasId: ID!
        text: String!
        x: Float!
        y: Float!
        width: Float!
        height: Float!
    ): AboutPage!
    addAboutPagePhotoBlock(
        canvasId: ID!
        mimeType: String!
        imageBase64: String!
        x: Float!
        y: Float!
        width: Float!
        height: Float!
    ): AboutPage!
    addAboutPageButtonBlock(
        canvasId: ID!
        text: String!
        linkUrl: String!
        x: Float!
        y: Float!
        width: Float!
        height: Float!
    ): AboutPage!
    addAboutPageGalleryBlock(
        canvasId: ID!
        x: Float!
        y: Float!
        width: Float!
        height: Float!
        slideIntervalSeconds: Float!
    ): AboutPage!
    addAboutPageGalleryPhoto(blockId: ID!, mimeType: String!, imageBase64: String!): AboutPage!
    removeAboutPageGalleryPhoto(blockId: ID!, imageId: ID!): AboutPage!
    updateAboutPageGalleryInterval(id: ID!, slideIntervalSeconds: Float!): AboutPage!
    updateAboutPageBlockLayout(id: ID!, x: Float!, y: Float!, width: Float!, height: Float!): AboutPage!
    updateAboutPageBlockAlign(id: ID!, align: AboutPageBlockAlign!): AboutPage!
    updateAboutPageBlockLayer(id: ID!, layer: Int!): AboutPage!
    updateAboutPageBlockText(id: ID!, text: String!, language: AboutPageLanguage! = EN): AboutPage!
    updateAboutPageBlockLink(id: ID!, linkUrl: String!): AboutPage!
    removeAboutPageBlock(id: ID!): AboutPage!
}

"""Singleton "About us" page. canvases is an ordered, admin-managed list of freeform
canvases, each holding its own text/photo/button/gallery blocks and its own resizable
height. Everything here is editable by admins only."""
type AboutPage {
    canvases: [AboutPageCanvas!]!
    updatedAt: String!
}

"""A single freeform canvas on the About page. height is the canvas's own height as a
percentage of its width (like an aspect ratio), resizable by admins. blocks are the
text/photo items placed on it."""
type AboutPageCanvas {
    id: ID!
    height: Float!
    backgroundImageId: ID
    rounded: Boolean!
    bordered: Boolean!
    blocks: [AboutPageBlock!]!
}

enum AboutPageBlockType {
    TEXT
    PHOTO
    BUTTON
    GALLERY
}

enum AboutPageMoveDirection {
    UP
    DOWN
}

enum AboutPageBlockAlign {
    LEFT
    CENTER
    RIGHT
}

enum AboutPageLanguage {
    EN
    RU
    SRB
}

"""A single item on a canvas. x/y is the top-left corner and width/height is the
footprint, all as percentages of the canvas so the layout is responsive. textEn/textRu/textSrb
hold a TEXT or BUTTON block's content per language, with textEn always set for those types
and textRu/textSrb optional overrides a reader falls back from to textEn when unset.
A GALLERY block instead carries its photos in galleryImageIds (in display order) and cycles
through them as a slideshow, advancing every slideIntervalSeconds. layer is the block's
stacking order within its canvas, from 1 (backmost) upwards, with no gaps or duplicates."""
type AboutPageBlock {
    id: ID!
    type: AboutPageBlockType!
    textEn: String
    textRu: String
    textSrb: String
    imageId: ID
    linkUrl: String
    galleryImageIds: [ID!]!
    slideIntervalSeconds: Float
    x: Float!
    y: Float!
    width: Float!
    height: Float!
    align: AboutPageBlockAlign!
    layer: Int!
    rounded: Boolean!
    highlighted: Boolean!
    icon: String
}
