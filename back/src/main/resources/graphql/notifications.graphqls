extend type Query {
    myNotifications(unreadOnly: Boolean): [Notification!]!
    unreadNotificationCount: Int!
}

extend type Mutation {
    markNotificationRead(id: ID!): Notification!
}

"""Persisted history of what's also pushed live over the /ws/notifications WebSocket."""
type Notification {
    id: ID!
    type: NotificationType!
    title: String!
    body: String
    subjectId: ID
    readAt: String
    createdAt: String!
}

enum NotificationType {
    PEN_PAL_REQUEST
    PEN_PAL_ACCEPTED
    LETTER_SENT
    LETTER_DELIVERED
}
