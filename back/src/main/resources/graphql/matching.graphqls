extend type Query {
    myMatches(limit: Int): [UserMatch!]!
    penPalRequests(status: PenPalRequestStatus): [PenPalRequest!]!
    myConnections: [PenPalConnection!]!
    suggestedProfiles(search: String, limit: Int, offset: Int): [SuggestedProfile!]!
    hiddenProfiles(limit: Int, offset: Int): [SuggestedProfile!]!
    pendingIncomingRequestCount: Int!
}

extend type Mutation {
    sendPenPalRequest(addresseeId: ID!, message: String): PenPalRequest!
    respondToPenPalRequest(id: ID!, accept: Boolean!): PenPalRequest!
    cancelPenPalRequest(id: ID!): PenPalRequest!
    endConnection(id: ID!): PenPalConnection!
    hideProfile(userId: ID!): Boolean!
}

"""One row per unordered pair of users; no synthetic id, the pair itself is the key."""
type UserMatch {
    userA: User!
    userB: User!
    score: Float!
    sharedInterests: [String!]!
    computedAt: String!
}

"""A suggested profile card for the matches feed; score/sharedInterests are null/empty until a match has been computed for this pair."""
type SuggestedProfile {
    user: User!
    score: Float
    sharedInterests: [String!]!
    hasIncomingRequest: Boolean!
}

type PenPalRequest {
    id: ID!
    requester: User!
    addressee: User!
    status: PenPalRequestStatus!
    message: String
    createdAt: String!
    respondedAt: String
}

enum PenPalRequestStatus {
    PENDING
    ACCEPTED
    DECLINED
    CANCELLED
}

type PenPalConnection {
    id: ID!
    userA: User!
    userB: User!
    request: PenPalRequest
    establishedAt: String!
    endedAt: String
    endedBy: User
}
