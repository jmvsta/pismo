extend type Query {
    forumTopics: [ForumTopic!]!
    forumPosts(topicId: ID, limit: Int, offset: Int): [ForumPost!]!
    forumPost(id: ID!): ForumPost
}

extend type Mutation {
    createForumPost(input: CreateForumPostInput!): ForumPost!
    createForumReply(input: CreateForumReplyInput!): ForumReply!
    updateForumPost(id: ID!, input: UpdateForumPostInput!): ForumPost!
    updateForumReply(id: ID!, body: String!): ForumReply!
    thankForumPost(postId: ID!): ForumPost!
    thankForumReply(replyId: ID!): ForumReply!
    createForumTopic(input: CreateForumTopicInput!): ForumTopic!
    setForumTopicActive(topicId: ID!, active: Boolean!): ForumTopic!
    deleteForumTopic(topicId: ID!): Boolean!
}

type ForumTopic {
    id: ID!
    code: String!
    title: String!
    description: String
    position: Int!
    active: Boolean!
}

type ForumPost {
    id: ID!
    topic: ForumTopic!
    author: User!
    title: String!
    body: String!
    replyCount: Int!
    thanksCount: Int!
    pinned: Boolean!
    photos: [ForumPostPhoto!]!
    replies: [ForumReply!]!
    createdAt: String!
    updatedAt: String!
}

type ForumPostPhoto {
    id: ID!
    imageId: ID!
    caption: String
    position: Int!
    createdAt: String!
}

"""parentReply is set for a threaded reply-to-a-reply; null for a top-level reply to the post."""
type ForumReply {
    id: ID!
    parentReply: ForumReply
    author: User!
    body: String!
    thanksCount: Int!
    photos: [ForumReplyPhoto!]!
    createdAt: String!
    updatedAt: String!
}

type ForumReplyPhoto {
    id: ID!
    imageId: ID!
    caption: String
    position: Int!
    createdAt: String!
}

input NewForumReplyPhotoInput {
    mimeType: String!
    imageBase64: String!
    caption: String
}

input CreateForumPostInput {
    topicId: ID!
    title: String!
    body: String!
    photos: [NewForumPostPhotoInput!]
}

input NewForumPostPhotoInput {
    mimeType: String!
    imageBase64: String!
    caption: String
}

input CreateForumReplyInput {
    postId: ID!
    parentReplyId: ID
    body: String!
    photos: [NewForumReplyPhotoInput!]
}

input CreateForumTopicInput {
    code: String!
    title: String!
    description: String
}

input UpdateForumPostInput {
    title: String
    body: String
}
